        <tri_type>SCRIPT</tri_type>
        <tri_webbot><![CDATA[	$ref = 'EjemploPerfil';
		$url = "http://localhost:58391/EvalCandidato.svc/api/". $ref . "/";
		$url .= @@personalidad1 . '_';
		$url .= @@tecnico1 . '_';
		$url .= @@habilidades1 . '_';
		$url .= @@salarial1 . '_';
		$url .= @@experiencia1 . '_';
		$url .= @@ingles1 . '_';
		$url .= @@frances1;

		$ur2 = "http://localhost:58391/EvalCandidato.svc/api/". $ref . "/";
		$ur2 .= @@personalidad2 . '_';
		$ur2 .= @@tecnico2 . '_';
		$ur2 .= @@habilidades2 . '_';
		$ur2 .= @@salarial2 . '_';
		$ur2 .= @@experiencia2 . '_';
		$ur2 .= @@ingles2 . '_';
		$ur2 .= @@frances2;

		$ur3 = "http://localhost:58391/EvalCandidato.svc/api/". $ref . "/";
		$ur3 .= @@personalidad3 . '_';
		$ur3 .= @@tecnico3 . '_';
		$ur3 .= @@habilidades3 . '_';
		$ur3 .= @@salarial3 . '_';
		$ur3 .= @@experiencia3 . '_';
		$ur3 .= @@ingles3 . '_';
		$ur3 .= @@frances3;

		

		$ch = curl_init($url);
		$cp = curl_init($ur2);
		$cq = curl_init($ur3);
		//curl_setopt($ch, CURLOPT_HTTPHEADER, array("Authorization: Bearer access-token"));
		curl_setopt($ch, CURLOPT_RETURNTRANSFER, true);
		curl_setopt($cp, CURLOPT_RETURNTRANSFER, true);
		curl_setopt($cq, CURLOPT_RETURNTRANSFER, true);
		//$oRet = json_decode(curl_exec($ch));
		$oRet = curl_exec($ch);
		$oRet2 = curl_exec($cp);
		$oRet3 = curl_exec($cq);
		@@resultado1 = $oRet;
		@@resultado2 = $oRet2;
		@@resultado3 = $oRet3;
		$status = curl_getinfo($ch, CURLINFO_HTTP_CODE);
		@@mensaje = 'Resultados C1:' .$status . ":" . $url;
		$status = curl_getinfo($cp, CURLINFO_HTTP_CODE);
		@@mensaje .= '.Resultados C2:' .$status . ":" . $ur2;
		$status = curl_getinfo($cq, CURLINFO_HTTP_CODE);
		@@mensaje .= '.Resultados C3:' .$status . ":" . $ur3;

]]></tri_webbot>
        <tri_param></tri_param>
      </record>
      <record>
        <tri_uid>4351501465aede261c5b663056882214</tri_uid>
        <tri_title>RegistrarAprobadoCV</tri_title>
        <tri_description></tri_description>
        <pro_uid>5824584965aede25a8748e2061238702</pro_uid>
        <tri_type>SCRIPT</tri_type>
        <tri_webbot><![CDATA[	$ci = @@ciCandidato;

	@@mensaje = "UPDATE PMT_CANDIDATO SET CVAPROBADO = 1 WHERE CI = '$ci' ";
	$result = executeQuery(@@mensaje);
	if ($result == 0){
		$g = new G();
		$g->SendMessageText('Error actualizanbdo valor en PM Table CANDIDATO.', 'ERROR');
	}
]]></tri_webbot>
        <tri_param></tri_param>
      </record>
      <record>
        <tri_uid>5704345705aede261c525d0091571055</tri_uid>
        <tri_title>IniVariablesSolicitud</tri_title>
        <tri_description></tri_description>
        <pro_uid>5824584965aede25a8748e2061238702</pro_uid>
        <tri_type>SCRIPT</tri_type>
        <tri_webbot><![CDATA[$datosUsuario = PMFInformationUser(@@USER_LOGGED);
@@usuarioSolicitante = $datosUsuario['firstname'] . ' ' . $datosUsuario['lastname'];
@@emailSolicitante = $datosUsuario['mail'];
]]></tri_webbot>
        <tri_param></tri_param>
      </record>
      <record>
        <tri_uid>8838500975aede261c57b63047658327</tri_uid>
        <tri_title>registrarConvocatoria</tri_title>
        <tri_description></tri_description>
        <pro_uid>5824584965aede25a8748e2061238702</pro_uid>
        <tri_type>SCRIPT</tri_type>
        <tri_webbot><![CDATA[	$ref = @@refConvocatoria;
	$cargo = @@nombreCargo;
	$ini = @=iniConvocatoria;
	$fin = @=finConvocatoria;
	@@mensaje = "INSERT PMT_CONVOCATORIA (REF, CARGO, FECHA_INI, FECHA_FIN) VALUES 	('$ref', '$cargo', '$ini', '$fin')";
	$result = executeQuery(@@mensaje);
	if ($result == 0){
		$g = new G();
		$g->SendMessageText('Error insertartando valor en PM Table CONVOCATORIA.', 'ERROR');
	}
]]></tri_webbot>
        <tri_param></tri_param>
      </record>
      <record>
        <tri_uid>9916076665aede261c54d30031688366</tri_uid>
        <tri_title>registrarCandidato</tri_title>
        <tri_description></tri_description>
        <pro_uid>5824584965aede25a8748e2061238702</pro_uid>
        <tri_type>SCRIPT</tri_type>
        <tri_webbot><![CDATA[	$ref = @@convocatoriaCandidato;
	$nom = @@nombresCandidato;
	$pat = @@paternoCandidato;
	$mat = @@maternoCandidato;
	$email = @@emailCandidato;
	$tel = @@telefonoCandidato;
	$dir = @@dirCandidato;
	$ci = @@ciCandidato;
	$exp = @@lugarciCandidato;

	$fileField = 'curriculumCandidato';
	$aReceipt = json_decode(@@curriculumCandidato);
	$Filename = empty($aReceipt) ? '' : $aReceipt[0];
	$Url = '';

if (!empty(@@curriculumCandidato)) {
   $caseId = @@APPLICATION;  //ID of the current case
   //Use ORDER BY APP_DOC_INDEX DESC to get the last file uploaded to the File field
   $query = "SELECT APP_DOC_UID, DOC_VERSION FROM APP_DOCUMENT
      WHERE APP_UID='$caseId' AND APP_DOC_FIELDNAME='$fileField' AND
      APP_DOC_STATUS = 'ACTIVE' ORDER BY APP_DOC_INDEX DESC";
   $results = executeQuery($query) or die("Error in query: $query");

   if (is_array($results) and count($results) > 0) {
      $Url = '../cases/cases_ShowDocument?a=' . $results[1]['APP_DOC_UID'] .
         '&v='. $results[1]['DOC_VERSION'];
   }
}
	@@mensaje = "INSERT PMT_CANDIDATO (REF_CONVOCATORIA, NOMBRES, PATERNO, MATERNO, EMAIL, TELEFONO, DIR, CI, CILUGAR, URL_CV) VALUES ('$ref', '$nom', '$pat', '$mat', '$email', '$tel', '$dir', '$ci' , '$exp', '$Url')";
	$result = executeQuery(@@mensaje);
	if ($result == 0){
		$g = new G();
		$g->SendMessageText('Error insertartando valor en PM Table CANDIDATO.', 'ERROR');
	}
]]></tri_webbot>
        <tri_param></tri_param>
      </record>
