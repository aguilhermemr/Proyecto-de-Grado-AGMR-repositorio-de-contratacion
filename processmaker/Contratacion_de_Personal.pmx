        <dyn_content><![CDATA[{"name":"Formulario de Postulación","description":"","items":[{"type":"form","variable":"","var_uid":"","dataType":"","id":"9394531255aede261bdfef7067870133","name":"Formulario de Postulación","description":"","mode":"edit","script":"","language":"en","externalLibs":"","printable":false,"items":[[{"type":"title","id":"title0000000001","label":"Formulario único de postulación a cargos abiertos","colSpan":12}],[{"type":"subtitle","id":"subtitle0000000001","label":"Seleccionar convocatoria","colSpan":12}],[{"type":"dropdown","variable":"convocatoriaCandidato","var_uid":"8110351565aede261cd2743042035620","dataType":"string","protectedValue":false,"id":"convocatoriaCandidato","name":"convocatoriaCandidato","label":"Convocatoria a la que Postula","defaultValue":"","placeholder":"","hint":"","required":false,"requiredFieldErrorMessage":"","mode":"parent","datasource":"database","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"SELECT REF, CONCAT(REF, '-', CARGO) as CARGO from PMT_CONVOCATORIA WHERE NOW() BETWEEN FECHA_INI AND FECHA_FIN;  ","dataVariable":"","options":[],"var_name":"convocatoriaCandidato","colSpan":12}],[{"type":"subtitle","id":"subtitle0000000002","label":"Datos Personales del Candidato","colSpan":12}],[{"type":"text","variable":"ciCandidato","var_uid":"7185974125aede261d0c417029992266","dataType":"string","protectedValue":false,"id":"ciCandidato","name":"ciCandidato","label":"Número de CI","defaultValue":"","placeholder":"","hint":"","required":false,"requiredFieldErrorMessage":"","textTransform":"none","validate":"^[0-9]+$","validateMessage":"Favor introducir solamente números en el campo CI","maxLength":1000,"formula":"","mode":"parent","operation":"","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","var_name":"ciCandidato","colSpan":12}],[{"type":"dropdown","variable":"lugarciCandidato","var_uid":"7552795415aede261d18a19059758190","dataType":"string","protectedValue":false,"id":"lugarci